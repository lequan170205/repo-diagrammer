{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit|apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "bash ${PLUGIN_ROOT:-${CLAUDE_PLUGIN_ROOT}}/hooks/validate_on_write.sh",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
